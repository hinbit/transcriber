# =============================================================================
#  Video Annotator — environment
# =============================================================================
#  cp .env.example .env      then fill in. Never commit .env.
#
#  Every value is read through env() which calls .trim(). A trailing space on
#  an API key produces a 401 that looks exactly like a wrong key.
# =============================================================================


# =============================================================================
#  PROVIDERS
# =============================================================================
#  There are TWO INDEPENDENT provider choices. They are separate because the
#  vendors do not offer the same things.
#
#    ASR_PROVIDER   speech-to-text     openai | gemini
#    LLM_PROVIDER   text generation    openai | anthropic | gemini
#
#  Anthropic appears only in the second list. Claude has no speech-to-text
#  API — it accepts text, images and PDFs, not audio. Setting
#  ASR_PROVIDER=anthropic fails at startup with an explanation.
#
#  Mixing is normal and often the right call, e.g. Gemini for cheap
#  transcription plus Claude for Hebrew titling:
#
#      ASR_PROVIDER=gemini
#      LLM_PROVIDER=anthropic
#
#  Run `hinbit-transcriber providers` to print the live capability matrix
#  and see which keys are actually loaded.
# -----------------------------------------------------------------------------

ASR_PROVIDER=openai
LLM_PROVIDER=openai


# -----------------------------------------------------------------------------
#  API KEYS — set the ones your chosen providers need
# -----------------------------------------------------------------------------

# Required when ASR_PROVIDER=openai or LLM_PROVIDER=openai
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required when LLM_PROVIDER=anthropic
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required when ASR_PROVIDER=gemini or LLM_PROVIDER=gemini
# https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
#  MODELS  (optional — sensible defaults are built in)
# -----------------------------------------------------------------------------

# ASR model when ASR_PROVIDER=gemini.
GEMINI_ASR_MODEL=gemini-2.5-flash

# Text models per provider. Used for summaries and segment enrichment.
OPENAI_LLM_MODEL=gpt-5-mini
ANTHROPIC_LLM_MODEL=claude-haiku-4-5-20251001
GEMINI_LLM_MODEL=gemini-2.5-flash

# Anthropic API version header. Do not change without reading their changelog.
ANTHROPIC_API_VERSION=2023-06-01


# =============================================================================
#  TRANSCRIPTION
# =============================================================================

# Timing accuracy — the single most consequential setting in this file.
#
#   word          per-word timestamps.                          (default)
#   segment       per-sentence timestamps.
#   proportional  text only; times interpolated across each
#                 chunk by character count.
#
# Accuracy depends on the ASR PROVIDER, not on the mode name alone:
#
#   mode           OpenAI (whisper-1)   Gemini (MM:SS)
#   ------------   ------------------   ------------------
#   word           +/-0.1s              UNSUPPORTED
#   segment        +/-0.5s              +/-1.5s
#   proportional   +/-15s               +/-15s
#
# Only `word` on OpenAI is accurate enough to drive tooltips without manual
# correction. `proportional` flags every segment approximate:true — treat its
# timings as a starting point, not as truth. Gemini's timings come from a
# generative model, so segments with implausible values are dropped rather
# than trusted, and the result carries a note saying so.
TRANSCRIBER_TIMING_MODE=word

# Source language hint (ISO 639-1). Improves Hebrew accuracy noticeably.
TRANSCRIBER_LANGUAGE=he

# Chunk length in seconds. Upload caps differ by provider:
#   OpenAI  25MB per request
#   Gemini  20MB per request including the prompt, and base64 inflates by ~33%
# At mono 16kHz/64kbps a 300s chunk is roughly 2.4MB — comfortable for both.
# If you switch to Gemini and see size errors, lower this to 240.
TRANSCRIBER_CHUNK_SECONDS=300

# Overlap between chunks, in milliseconds. Chunks are cut with this much
# lead-in and duplicated words are removed afterwards using their timestamps.
# Below ~800ms words start getting clipped at the seams.
TRANSCRIBER_OVERLAP_MS=1500

# Parallel chunk requests. Raise for speed, lower if you hit 429s.
# Gemini free-tier quotas are tighter than OpenAI's — start at 2 there.
TRANSCRIBER_CONCURRENCY=3

# Retry attempts per API call (exponential backoff, honours Retry-After).
TRANSCRIBER_RETRY_ATTEMPTS=3

# Cache transcription results keyed by audio content hash + provider + every
# parameter that affects output. Re-running an unchanged project costs nothing.
# Switching providers does NOT collide: each gets its own cache entry.
TRANSCRIBER_CACHE=true

# Batched LLM pass adding shortTitle, keywords and a meaningfulness verdict.
# Set false to skip entirely — transcription still works, titles stay empty.
TRANSCRIBER_ENRICH=true

# Segments per LLM request. One call per segment costs ~20x more for the same
# result. Lower only if you hit context limits on very long sentences.
TRANSCRIBER_LLM_BATCH_SIZE=40

# Verbose provider diagnostics: dropped Gemini segments, failed enrich batches.
# TRANSCRIBER_DEBUG=1


# =============================================================================
#  PATHS
# =============================================================================

# Scratch space: downloaded audio, chunks, transcription cache.
# Safe to delete; it rebuilds, re-paying the API cost.
TRANSCRIBER_WORK_DIR=storage/work
VA_WORK_DIR=storage/work

# Durable project data: manifests, transcripts, annotation JSON, images.
# THIS IS THE ONE TO BACK UP.
VA_DATA_DIR=storage/projects

# CLI output directory when running hinbit-transcriber directly.
TRANSCRIBER_OUTPUT_DIR=output_text


# =============================================================================
#  SERVER
# =============================================================================

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Where the player/admin runs. MUST match the browser origin exactly, including
# scheme and port — it is written into the YouTube embed URL as ?origin=, and
# without a match the IFrame API ignores every postMessage. Silently: no error,
# no warning, the clock simply never advances.
VA_PUBLIC_ORIGIN=http://localhost:5173

# Comma-separated CORS allowlist.
VA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# =============================================================================
#  QUEUE
# =============================================================================

REDIS_URL=redis://127.0.0.1:6379

# Simultaneous ingest jobs. Each job already parallelises its own chunks, so
# more than 1 or 2 mostly multiplies ffmpeg memory and API rate limiting.
VA_WORKER_CONCURRENCY=1


# =============================================================================
#  YT-DLP  (optional)
# =============================================================================

# Netscape-format cookie file for age-restricted or members-only videos.
# YTDLP_COOKIES_FILE=/etc/va/youtube-cookies.txt

# Proxy for regions where YouTube blocks the server IP.
# YTDLP_PROXY=http://user:pass@proxy.internal:8080


# =============================================================================
#  SYSTEM REQUIREMENTS
# =============================================================================
#
#  Binaries on PATH: ffmpeg, ffprobe, yt-dlp
#
#  yt-dlp breaks whenever YouTube changes something. Pin a version and schedule
#  updates, or catch the error and show the operator:
#
#      python3 -m pip install --user -U yt-dlp
#
# =============================================================================
