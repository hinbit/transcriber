{
  "name": "@hinbit/transcriber",
  "version": "2.2.0",
  "description": "Transcription with usable timestamps: YouTube links or local files, word-level timings, sentence segmentation, WebVTT/SRT output.",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "hinbit-transcriber": "./bin/hinbit-transcriber.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "bin",
    "examples",
    "README.md",
    ".env.example",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "cli": "node bin/hinbit-transcriber.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "transcription",
    "whisper",
    "youtube",
    "subtitles",
    "webvtt",
    "timestamps",
    "hebrew"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hinbit/transcriber.git"
  },
  "homepage": "https://github.com/hinbit/transcriber#readme",
  "bugs": {
    "url": "https://github.com/hinbit/transcriber/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
